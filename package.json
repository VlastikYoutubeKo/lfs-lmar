{
  "name": "lfs-live-map-radio",
  "version": "2.0.0",
  "description": "Live for Speed real-time map with navigation",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "pkg . --compress GZip"
  },
  "keywords": ["lfs", "live-for-speed", "map", "insim"],
  "author": "Vlastimil",
  "license": "MIT",
  "dependencies": {
    "node-insim": "^3.4.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "pkg": {
    "assets": [
      "*.html",
      "*.js",
      "*.css",
      "tracks/**/*"
    ],
    "targets": [
      "node18-win-x64"
    ],
    "outputPath": "dist"
  }
}