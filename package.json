{
  "name": "lfs-live-map-radio",
  "version": "1.0.0",
  "description": "Live For Speed InSim aplikace s real-time mapou a funkčním rádiem",
  "main": "server.js",
  "type": "module",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "build": "node build.js",
    "build:exe": "pkg . --out-path dist --targets node20-win-x64",
    "prebuild": "node prebuild.js"
  },
  "keywords": [
    "lfs",
    "insim",
    "live-for-speed",
    "racing",
    "radio",
    "live-map"
  ],
  "author": "Vlastimil",
  "license": "MIT",
  "dependencies": {
    "node-insim": "^3.1.0",
    "react": "^18.3.1",
    "react-node-insim": "^0.3.1",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "pkg": "^5.8.1"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "radio_config.json",
      "node_modules/**/*"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "dist"
  }
}
